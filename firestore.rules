rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // User Profile
    function isValidUser(data) {
      return data.keys().hasAll(['name', 'balance', 'cashBalance', 'requireBiometrics', 'jar'])
        && data.name is string && data.name.size() <= 100
        && data.balance is number && data.balance >= 0
        && data.cashBalance is number && data.cashBalance >= 0
        && data.requireBiometrics is bool
        && data.jar is map
        && data.jar.keys().hasAll(['title', 'currentAmount', 'targetAmount'])
        && data.jar.title is string && data.jar.title.size() <= 100
        && data.jar.currentAmount is number && data.jar.currentAmount >= 0
        && data.jar.targetAmount is number && data.jar.targetAmount >= 0
        && ( !('createdAt' in data.keys()) || (data.createdAt is string || data.createdAt is timestamp) )
        && ( !('updatedAt' in data.keys()) || (data.updatedAt is string || data.updatedAt is timestamp) );
    }

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow create, update: if isOwner(userId) && isValidId(userId)
        && isValidUser(incoming());
      allow delete: if isOwner(userId) && isValidId(userId);
    }

    // Transactions
    function isValidTransaction(data, userId) {
      return data.keys().hasAll(['userId', 'type', 'amount', 'title', 'category', 'date', 'status', 'receiptNumber'])
        && data.userId == userId
        && data.type in ['income', 'expense']
        && data.amount is number && data.amount >= 0
        && data.title is string && data.title.size() <= 200
        && data.category is string && data.category.size() <= 100
        && ( !('description' in data.keys()) || (data.description is string && data.description.size() <= 500) )
        && data.date is string
        && data.status in ['success', 'pending', 'failed']
        && data.receiptNumber is string && data.receiptNumber.size() <= 100
        && ( !('isCash' in data.keys()) || data.isCash is bool )
        && ( !('paymentMethod' in data.keys()) || (data.paymentMethod is string && data.paymentMethod in ['cash', 'atm', 'sense_card']) )
        && ( !('location' in data.keys()) || (data.location is string && data.location.size() <= 300) );
    }

    match /users/{userId}/transactions/{transactionId} {
      allow get: if isOwner(userId) && isValidId(userId) && isValidId(transactionId);
      allow list: if isOwner(userId) && isValidId(userId);
      allow create, update: if isOwner(userId) && isValidId(userId) && isValidId(transactionId)
        && isValidTransaction(incoming(), userId);
      allow delete: if isOwner(userId) && isValidId(userId) && isValidId(transactionId);
    }

    // Cash Envelopes
    function isValidCashEnvelope(data, userId) {
      return data.keys().hasAll(['userId', 'name', 'amount', 'targetAmount', 'category', 'iconName'])
        && data.userId == userId
        && data.name is string && data.name.size() <= 100
        && data.amount is number && data.amount >= 0
        && data.targetAmount is number && data.targetAmount >= 0
        && data.category is string && data.category.size() <= 100
        && data.iconName is string && data.iconName.size() <= 50;
    }

    match /users/{userId}/cashEnvelopes/{envelopeId} {
      allow get: if isOwner(userId) && isValidId(userId) && isValidId(envelopeId);
      allow list: if isOwner(userId) && isValidId(userId);
      allow create, update: if isOwner(userId) && isValidId(userId) && isValidId(envelopeId)
        && isValidCashEnvelope(incoming(), userId);
      allow delete: if isOwner(userId) && isValidId(userId) && isValidId(envelopeId);
    }

    // Security Logs
    function isValidSecurityLog(data, userId) {
      return data.keys().hasAll(['userId', 'timestamp', 'status'])
        && data.userId == userId
        && data.timestamp is string
        && data.status in ['success', 'failed', 'failure']
        && ( !('type' in data.keys()) || (data.type is string && data.type.size() <= 100) )
        && ( !('device' in data.keys()) || (data.device is string && data.device.size() <= 200) )
        && ( !('action' in data.keys()) || (data.action is string && data.action.size() <= 200) );
    }

    match /users/{userId}/securityLogs/{logId} {
      allow get: if isOwner(userId) && isValidId(userId) && isValidId(logId);
      allow list: if isOwner(userId) && isValidId(userId);
      allow create: if isOwner(userId) && isValidId(userId) && isValidId(logId)
        && isValidSecurityLog(incoming(), userId);
      allow update, delete: if isOwner(userId) && isValidId(userId) && isValidId(logId);
    }
  }
}
